# Copy to backend/.env (gitignored) and fill in. Only the settings you want to
# change need to be there - everything has a default. See backend/README.md.

# --- AI ---------------------------------------------------------------------
AI_PROVIDER=groq                # "anthropic" (default) or "groq"
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Login -------------------------------------------------------------------
# Who is an admin (comma-separated). They get /admin and the AI-key button.
ADMIN_EMAILS=you@example.cz

# Signs the session cookie and keys the login-code hash. Set a long random
# value on any shared deployment, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# NICEGUI_STORAGE_SECRET=

# --- Email (how login codes reach people) ------------------------------------
# "console" only prints the code in the server log - fine for development,
# nothing is emailed. Use "smtp" to send real mail, then check the setup with:
#     python scripts/send_test_email.py you@example.cz
EMAIL_BACKEND=smtp

# Pick ONE of the presets below (the values are the providers' documented
# defaults - double-check against their current help pages).

# Seznam.cz mailbox (the username is the full address):
SMTP_HOST=smtp.seznam.cz
SMTP_SECURITY=ssl               # port defaults to 465; "starttls" + 587 also works
SMTP_USER=you@seznam.cz
SMTP_PASSWORD=
# SMTP_FROM=you@seznam.cz       # defaults to SMTP_USER; must be the account's own address

# Gmail (needs 2-step verification and an *app password*, not the normal one):
# SMTP_HOST=smtp.gmail.com
# SMTP_SECURITY=starttls        # port defaults to 587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
#
# Resend (transactional, generous free tier - recommended if you don't want
# to send from a personal mailbox): SMTP_USER is literally "resend", the
# password is an API key from resend.com. Their sandbox sender
# "onboarding@resend.dev" only delivers to your own account email - verify a
# domain there (they give you the DNS records) before real users log in.
# SMTP_HOST=smtp.resend.com
# SMTP_SECURITY=starttls        # port defaults to 587
# SMTP_USER=resend
# SMTP_PASSWORD=                # a Resend API key, e.g. re_...
# SMTP_FROM=onboarding@resend.dev   # or you@yourverifieddomain.cz once verified
#
# Any other transactional provider (Brevo, Mailgun, SendGrid, ...): take
# host, port, user and password from its "SMTP" page; the sender address
# must be one you verified there, and you add its SPF/DKIM DNS records for
# your domain. Swapping providers is only ever these SMTP_* values - the
# code (app/services/mailer.py) is provider-agnostic.

SMTP_FROM_NAME=Rovis            # shown next to the sender address in the inbox

# --- Optional tuning (defaults shown) -----------------------------------------
# LOGIN_CODE_TTL_MINUTES=10
# LOGIN_CODE_MAX_ATTEMPTS=5
# LOGIN_CODE_MAX_REQUESTS_PER_EMAIL_HOUR=5
# LOGIN_CODE_MAX_REQUESTS_PER_IP_HOUR=20
# AUTH_SESSION_DAYS=30
